# Routing output: <name>.mosbius.json and anything else generated.
build/
__pycache__/
*.pyc
.pytest_cache/

# Where xschem's Netlist button writes when it is NOT reading this repo's
# xschemrc: a simulation/ (or simulations/) directory beside the schematic,
# per its simuldir proc. Launched from the repo root it writes build/
# instead, so one of these appearing means xschem was started from the wrong
# directory -- in which case the netlist is also missing every device.
# Ignored so a stray one is never committed.
simulation/
simulations/

# Logs from redirecting the router's output.
*.log

# Work in progress: if you draw a design in the library directory rather
# than in its own, name it here individually -- NOT xschem/mosbius_lib/*.sch,
# which would also cover minimosbius_template.sch, tb_template.sch and the
# five mosbius_*.sch device schematics, all of which belong in git. Finished
# designs go to examples/<name>/ and are tracked there; there are no ignored
# schematics at the moment.
