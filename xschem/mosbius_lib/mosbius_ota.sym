v {xschem version=3.4.8RC file_version=1.2}
G {}
K {type=subcircuit
format="@name @pinlist @symname tail=@tail"
template="name=X1 tail=2"
}
V {}
S {}
E {}
L 4 -40 -60 -40 60 {}
L 4 -40 -60 40 -20 {}
L 4 -40 60 40 20 {}
B 5 -82.5 -42.5 -77.5 -37.5 {name=inp dir=in}
B 5 -82.5 37.5 -77.5 42.5 {name=inm dir=in}
B 5 77.5 -22.5 82.5 -17.5 {name=outp dir=inout}
B 5 77.5 17.5 82.5 22.5 {name=outm dir=inout}
B 5 -2.5 -82.5 2.5 -77.5 {name=ibias dir=in}
B 5 -42.5 -2.5 -37.5 2.5 {name=bn dir=inout}
B 5 37.5 -2.5 42.5 2.5 {name=bp dir=inout}
T {@symname} -70 -70 0 0 0.3 0.3 {}
T {@name} 60 -70 0 0 0.2 0.2 {}
T {tail=@tail} 60 60 0 0 0.2 0.2 {}
T {inp} -75 -35 0 1 0.12 0.12 {}
T {inm} -75 35 0 1 0.12 0.12 {}
T {outp} 70 -25 0 1 0.12 0.12 {}
T {outm} 70 25 0 1 0.12 0.12 {}
