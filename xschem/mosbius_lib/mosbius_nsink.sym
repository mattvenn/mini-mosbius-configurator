v {xschem version=3.4.8RC file_version=1.2
*
* mini-MOSbius programmable NMOS current sink (a 1:ratio mirror slave).
* Drawn as a current source because that is what it behaves like: the
* only two current-carrying terminals are `out` and the VGND end, and
* the VGND end is fixed. `ibias` is the mirror's reference leg.
*
* The body terminal is NOT drawn. On silicon it is hard-wired to a rail
* and you cannot route it, so drawing it would only add a wire you are
* never allowed to place anywhere else. It is supplied instead by the
* `extra` mechanism below: the netlist still gets the connection, the
* schematic does not. Override per instance with b=<net> if you ever need to.
*
* The pin-box (B) records below are declared in netlist pin order, which
* is also the .subckt port order -- extra pins are appended, in the order
* `extra` lists them. mosbius/netlist.py's DEVICE_PINS holds a matching
* copy and mosbius/schgen.py holds the pin coordinates -- change all
* three together.
}
G {}
K {type=subcircuit
format="@spiceprefix@name @pinlist @b @symname ratio=@ratio"
template="name=M1 ratio=1 b=VGND spiceprefix=X"
extra="b"
}
V {}
S {}
E {}
L 4 0 -40 0 -15 {}
L 4 0 15 0 25 {}
L 4 -10 25 10 25 {}
L 4 -6 30 6 30 {}
L 4 -2 35 2 35 {}
L 4 -40 0 -15 0 {}
A 4 0 0 15 270 360 {}
P 4 7 0 -7.5 0 2.5 2.5 2.5 0 10 -2.5 2.5 0 2.5 0 -7.5 {fill=true}
B 5 -42.5 -2.5 -37.5 2.5 {name=ibias dir=in}
B 5 -2.5 -42.5 2.5 -37.5 {name=out dir=inout}
T {@name} 24 -17 0 0 0.2 0.2 {}
T {ratio=@ratio} 24 1 0 0 0.15 0.15 {}
T {ibias} -42 -16 0 0 0.13 0.13 {}
T {@b} 14 26 0 0 0.15 0.15 {}
T {@#1:net_name} 6 -52 0 0 0.15 0.15 {layer=15 hide=instance}
T {@#0:net_name} -42 6 0 0 0.15 0.15 {layer=15 hide=instance}
