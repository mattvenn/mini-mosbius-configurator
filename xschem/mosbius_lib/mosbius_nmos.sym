v {xschem version=3.4.8RC file_version=1.2
*
* mini-MOSbius generic device symbol. Drawing and pin coordinates are
* taken from xschem's own devices/nmos3.sym so these read and snap like
* any other FET on the sheet.
*
* The body terminal is NOT drawn. On silicon it is hard-wired to a rail
* and you cannot route it, so drawing it would only add a wire you are
* never allowed to place anywhere else. It is supplied instead by the
* `extra` mechanism below: the netlist still gets a 4th connection, the
* schematic does not. Override per instance with b=<net> if you ever
* need to (mosbius_ota.sch does, to reach its own bulk port).
*
* The B{} box ORDER below is the netlist pin order and the .subckt port
* order. mosbius/netlist.py's DEVICE_PINS holds a matching copy, and
* mosbius/schgen.py holds the pin coordinates. Change all three together.
* (Note this is g,d,s -- devices/nmos3.sym declares d,g,s. Geometry matches,
* declaration order deliberately does not: reordering would rename every
* routed device and force a re-route for no visible gain.)
}
G {}
K {type=subcircuit
format="@name @pinlist @b @symname w=@w"
template="name=M1 w=1 b=VGND"
extra="b"
}
V {}
S {}
E {}
L 4 5 -30 5 30 {}
L 4 5 -20 20 -20 {}
L 4 20 -30 20 -20 {}
L 4 5 20 20 20 {}
L 4 20 20 20 30 {}
L 4 -5 -15 -5 15 {}
L 4 -20 0 -5 0 {}
B 5 -22.5 -2.5 -17.5 2.5 {name=g dir=in}
B 5 17.5 -32.5 22.5 -27.5 {name=d dir=inout}
B 5 17.5 27.5 22.5 32.5 {name=s dir=inout}
T {d} 24 -38 0 0 0.13 0.13 {}
T {g} -24 -12 0 0 0.13 0.13 {}
T {s} 24 24 0 0 0.13 0.13 {}
T {@name} 34 -14 0 0 0.2 0.2 {}
T {w=@w} 34 2 0 0 0.2 0.2 {}
T {@b} 34 18 0 0 0.15 0.15 {layer=1}
T {@#1:net_name} 25 -42.5 0 0 0.15 0.15 {layer=15 hide=instance}
T {@#2:net_name} 25 32.5 0 0 0.15 0.15 {layer=15 hide=instance}
T {@#0:net_name} -25 -12.5 0 1 0.15 0.15 {layer=15 hide=instance}
