# xschem configuration for this repo.
#
# xschem reads `xschemrc` from its current working directory, so this file
# applies whenever you launch xschem from the top of the repo:
#
#     xschem examples/inverter/inverter.sch
#
# It does three things: find the PDK's device symbols and models (pinning
# the variant to sky130A, see below), find our own symbol library, and put
# every netlist in one place.

# Where this file lives -- computed before sourcing anything else, because
# `info script` follows whichever file is currently being sourced.
set mosbius_root [file dirname [file normalize [info script]]]

# 1. sky130A. The container defaults PDK to ihp-sg13g2, so name sky130A
#    explicitly rather than relying on $PDK. This brings in nfet3_*/pfet3_*
#    (which mosbius_nmos.sch/mosbius_pmos.sch instantiate) and devices/.
if {[info exists env(PDK_ROOT)]} {
    set mosbius_pdk_root $env(PDK_ROOT)
} else {
    set mosbius_pdk_root /foss/pdks
}
#    Naming the file explicitly is not enough on its own: the file we are
#    about to source derives SKYWATER_MODELS (and the library path) from
#    $env(PDK) itself, so with the container's default still in place it
#    resolves sky130's own symbols but writes
#    `.lib /foss/pdks/ihp-sg13g2/libs.tech/combined/sky130.lib.spice tt`
#    into every netlist -- a path that doesn't exist, from a netlist that
#    otherwise looks perfectly fine. Set the variant first, for us and for
#    everything sourced below. Verified 2026-08-23.
set env(PDK) sky130A
source $mosbius_pdk_root/sky130A/libs.tech/xschem/xschemrc

# 2. Our library. Must come AFTER the source above: the sky130A xschemrc
#    resets XSCHEM_LIBRARY_PATH to {} and builds it up, so appending before
#    it would be silently discarded.
append XSCHEM_LIBRARY_PATH :[file join $mosbius_root xschem mosbius_lib]

# 3. One netlist directory for the whole repo, rather than a simulation/
#    beside each schematic. build/ is gitignored.
set netlist_dir [file join $mosbius_root build]

# 4. What a testbench should emit for a design's routed netlist -- the
#    output of `mosbius simulate`, which lives in build/ and is therefore
#    NOT in a fresh clone. A testbench calls this from an instance's
#    spice_sym_def instead of writing a bare `.include`:
#
#        spice_sym_def="tcleval([mosbius_routed_include build/ring_routed.spice])"
#
#    When the file is there this is exactly the bare .include it replaces.
#    When it is not, netlisting still succeeds (xschem has no reason to
#    fail -- it is only writing a path), and the failure surfaces two
#    steps later as ngspice's "Could not find include file ...", which
#    names the file but not the command that makes it. Someone who has
#    just cloned the repo and opened an example has no way to get from
#    that to `mosbius simulate`. So say it here, at the moment they press
#    Netlist: a dialog if there is a GUI, and a comment block in the
#    netlist itself, which is what a batch/CI run gets. (The puts to
#    stderr below does NOT reach the terminal from `xschem -n -q` -- xschem
#    swallows it. Verified 2026-08-24. It is left in for the GUI's own Tcl
#    console; the netlist comment is the one that always lands.)
#
#    Keep every double quote out of the returned text. xschem re-parses a
#    tcleval result as a property value, so a quote inside it truncates the
#    netlist mid-message AND swallows the .include that follows -- verified
#    2026-08-24, it silently emitted half a sentence and no include line.
proc mosbius_routed_include {path} {
    set abs [file normalize $path]
    if {[file exists $path]} {
        # Arm the warning again, so if this file ever goes missing later the
        # user is told about it then too.
        unset -nocomplain ::mosbius_warned($path)
        return [mosbius_routed_staleness $path $abs]
    }
    set lines [list \
        "$path has not been generated yet" \
        "" \
        "control click the 'generate routed spice button'" ]
    set msg [join $lines "\n"]
    puts stderr "\n*** $msg\n"
    # xschem evaluates this property TWICE per netlist run -- measured, by
    # logging every call: same pid, the second call sees the first call's
    # globals. So a dialog raised unconditionally here has to be dismissed
    # twice.
    #
    # Two timing-based guards were tried and both fail for the same reason:
    # tk_messageBox is modal, so it blocks until the user clicks, and the
    # SECOND evaluation only happens after that. A window short enough to
    # still warn on a later netlist has always expired by then, and an
    # `after` timer has already fired. Nothing measured in seconds can win
    # a race against a human dismissing a dialog.
    #
    # So: a one-shot flag per path, cleared in the exists branch above. One
    # dialog per problem, however slow the reader. The cost is that pressing
    # Netlist again while the file is still missing does not raise it a
    # second time -- the netlist comment block above and ngspice's own
    # "Could not find include file" still cover that.
    if {[info exists ::has_x] && ![info exists ::mosbius_warned($path)]} {
        set ::mosbius_warned($path) 1
        catch {mosbius_show_routed_warning $msg}
    }
    set out {}
    foreach l $lines { lappend out "* $l" }
    return "[join $out "\n"]\n.include $abs"
}

# Which .sch a generated routed netlist came from: build/ring_routed.spice
# -> ring.sch. Looked for beside the schematic being netlisted first, since
# a design and its testbench nearly always sit together, then under
# examples/ and the symbol library. Returns empty if it cannot be found --
# a missed check is a far smaller harm than telling someone their fresh
# netlist is stale when it is not.
proc mosbius_design_sch {path} {
    set base [file rootname [file tail $path]]
    if {[string match *_routed $base]} {
        set base [string range $base 0 end-7]
    }
    set cands {}
    catch {lappend cands [file join [file dirname [xschem get schname]] $base.sch]}
    foreach d [glob -nocomplain examples/*/$base.sch xschem/mosbius_lib/$base.sch] {
        lappend cands $d
    }
    foreach c $cands {
        if {[file isfile $c]} { return $c }
    }
    return {}
}

# The routed netlist exists, but is it still the circuit on the sheet?
#
# This is the quiet failure the whole drawn-vs-routed testbench is exposed
# to. The drawn instance re-reads its schematic= every time you press
# Netlist, so it is always current; the routed instance is a generated file
# three steps downstream. Edit the design, forget to regenerate, and you
# get today's drawn circuit compared against last week's routed one -- and
# it runs, and prints plausible numbers, and the only thing that was
# supposed to differ between the two halves was fidelity.
#
# The .include is still emitted: refusing here would surface as ngspice
# complaining about a missing subcircuit, which points even further from
# the cause. The comment block and the dialog are the warning.
proc mosbius_routed_staleness {path abs} {
    set sch [mosbius_design_sch $path]
    if {$sch eq {} || [file mtime $sch] <= [file mtime $path]} {
        unset -nocomplain ::mosbius_stale_warned($path)
        return ".include $abs"
    }
    set lines [list \
        "$sch was edited after $path was generated." \
        "" \
        "control click the 'generate routed spice' button to update it." ]
    set msg [join $lines "\n"]
    puts stderr "\n*** $msg\n"
    if {[info exists ::has_x] && ![info exists ::mosbius_stale_warned($path)]} {
        set ::mosbius_stale_warned($path) 1
        catch {mosbius_show_stale_warning $msg}
    }
    set out {}
    foreach l $lines { lappend out "* $l" }
    return "[join $out "\n"]\n.include $abs"
}

proc mosbius_show_stale_warning {msg} {
    catch {tk_messageBox -icon warning -type ok \
        -title {routed netlist is out of date} -message $msg}
}

# The dialog half of mosbius_routed_include, kept separate so the guard
# there reads as one line -- see the comment beside it.
proc mosbius_show_routed_warning {msg} {
    catch {tk_messageBox -icon warning -type ok \
        -title {routed netlist not generated yet} -message $msg}
}
